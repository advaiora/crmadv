      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 404', function () { pm.response.to.have.status(404); });",
              "pm.test('code NOT_FOUND', function () { pm.expect(json.error.code).to.eql('NOT_FOUND'); });"
            ]
          }
        }
      ]
