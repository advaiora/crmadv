    {
      "name": "5.17 - Cross-workspace access returns 404",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-email", "value": "{{userEmail}}" },
          { "key": "x-workspace-id", "value": "{{otherWorkspaceId}}" }
        ],
