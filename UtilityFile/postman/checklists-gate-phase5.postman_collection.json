{
  "info": {
    "name": "Checklists Gate - Fase 5 Hardening",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup - Disable checklists module",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-email", "value": "{{userEmail}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/workspaces/{{workspaceId}}/modules",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"modules\": [\n    { \"key\": \"checklists\", \"enabled\": false }\n  ]\n}"
        },
        "description": "Helper per test 5.3. Richiede modules.manage."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Setup - Enable checklists module",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-email", "value": "{{userEmail}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/workspaces/{{workspaceId}}/modules",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"modules\": [\n    { \"key\": \"checklists\", \"enabled\": true }\n  ]\n}"
        },
        "description": "Helper di ripristino modulo checklists."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5.1 - 401 Missing auth headers",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/checklists/templates"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 401', function () { pm.response.to.have.status(401); });",
              "pm.test('code UNAUTHORIZED', function () { pm.expect(json.error.code).to.eql('UNAUTHORIZED'); });",
              "pm.test('message', function () { pm.expect(json.error.message).to.eql('Authentication headers are missing'); });",
              "pm.test('expected headers', function () {",
              "  pm.expect(json.error.details.expected).to.include('x-user-id');",
              "  pm.expect(json.error.details.expected).to.include('x-user-email');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5.2 - 400 Missing workspace header",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-email", "value": "{{userEmail}}" }
        ],
        "url": "{{baseUrl}}/checklists/templates"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 400', function () { pm.response.to.have.status(400); });",
              "pm.test('code BAD_REQUEST', function () { pm.expect(json.error.code).to.eql('BAD_REQUEST'); });",
              "pm.test('message', function () { pm.expect(json.error.message).to.eql('Workspace header is required'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5.3 - 403 Module disabled",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-email", "value": "{{userEmail}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" }
        ],
        "url": "{{baseUrl}}/checklists/templates",
        "description": "Eseguire prima Setup - Disable checklists module."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 403', function () { pm.response.to.have.status(403); });",
              "pm.test('code FORBIDDEN', function () { pm.expect(json.error.code).to.eql('FORBIDDEN'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5.4 - 403 Missing permission",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-user-id", "value": "{{limitedUserId}}" },
          { "key": "x-user-email", "value": "{{limitedUserEmail}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" }
        ],
        "url": "{{baseUrl}}/checklists/templates",
        "description": "Utente membro workspace ma senza permission checklists.view."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 403', function () { pm.response.to.have.status(403); });",
              "pm.test('code FORBIDDEN', function () { pm.expect(json.error.code).to.eql('FORBIDDEN'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5.5 - Create template",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-email", "value": "{{userEmail}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/checklists/templates",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{templateName}}\",\n  \"description\": \"Checklist onboarding sito\",\n  \"items\": [\n    {\n      \"title\": \"Raccolta credenziali\",\n      \"description\": \"Accessi principali\",\n      \"isRequired\": true,\n      \"requiresEvidenceSnapshot\": true,\n      \"isCriticalSnapshot\": true\n    }\n  ]\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('templateName', 'Onboarding sito ' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 201', function () { pm.response.to.have.status(201); });",
              "pm.test('template id', function () { pm.expect(json.data.id).to.be.a('string'); });",
              "pm.collectionVariables.set('templateId', json.data.id);",
              "if (json.data.items && json.data.items.length > 0) {",
              "  pm.collectionVariables.set('templateItemId', json.data.items[0].id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5.6 - Duplicate template name",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-email", "value": "{{userEmail}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/checklists/templates",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{templateName}}\",\n  \"description\": \"Duplicato\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 409', function () { pm.response.to.have.status(409); });",
              "pm.test('code DUPLICATE_TEMPLATE_NAME', function () { pm.expect(json.error.code).to.eql('DUPLICATE_TEMPLATE_NAME'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5.7.1 - Create item",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-email", "value": "{{userEmail}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/checklists/templates/{{templateId}}/items",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Conferma contenuti\",\n  \"description\": \"Materiale definitivo\",\n  \"isRequired\": true,\n  \"requiresEvidenceSnapshot\": false,\n  \"isCriticalSnapshot\": false\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 201', function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('templateItemId2', json.data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "5.7.2 - Reorder items",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-email", "value": "{{userEmail}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/checklists/templates/{{templateId}}/items/reorder",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderedItemIds\": [\"{{templateItemId2}}\", \"{{templateItemId}}\"]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('sort normalized', function () {",
              "  pm.expect(json.data.items[0].sortOrder).to.eql(0);",
              "  pm.expect(json.data.items[1].sortOrder).to.eql(1);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5.8 - Reorder mismatch",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-email", "value": "{{userEmail}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/checklists/templates/{{templateId}}/items/reorder",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderedItemIds\": [\"{{templateItemId}}\"]\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
