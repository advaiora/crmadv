    },
    {
      "name": "5.9 - Create instance for project",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-email", "value": "{{userEmail}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/projects/{{projectId}}/checklists",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"checklistTemplateId\": \"{{templateId}}\",\n  \"pipelineStageId\": \"{{pipelineStageId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 201 or 200', function () { pm.expect([200, 201]).to.include(pm.response.code); });",
              "pm.collectionVariables.set('instanceId', json.data.id);",
              "const evidenceItem = (json.data.items || []).find((item) => item.requiresEvidenceSnapshot === true) || (json.data.items || [])[0];",
              "if (evidenceItem) {",
              "  pm.collectionVariables.set('requiredEvidenceItemId', evidenceItem.id);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "5.10 - Duplicate instance idempotent",
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-email", "value": "{{userEmail}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/projects/{{projectId}}/checklists",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"checklistTemplateId\": \"{{templateId}}\",\n  \"pipelineStageId\": \"{{pipelineStageId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('same instance', function () {",
              "  pm.expect(json.data.id).to.eql(pm.collectionVariables.get('instanceId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5.11 - Complete requiresEvidence without evidence",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-email", "value": "{{userEmail}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/checklists/items/{{requiredEvidenceItemId}}/complete",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 400', function () { pm.response.to.have.status(400); });",
              "pm.test('code EVIDENCE_REQUIRED', function () { pm.expect(json.error.code).to.eql('EVIDENCE_REQUIRED'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5.12 - Complete item OK",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-email", "value": "{{userEmail}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/checklists/items/{{requiredEvidenceItemId}}/complete",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"evidenceNote\": \"ok\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('state completed', function () { pm.expect(json.data.state).to.eql('completed'); });",
              "pm.test('completedAt present', function () { pm.expect(json.data.completedAt).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5.13 - Complete item again",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-email", "value": "{{userEmail}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/checklists/items/{{requiredEvidenceItemId}}/complete",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"evidenceNote\": \"second try\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 409', function () { pm.response.to.have.status(409); });",
              "pm.test('code ITEM_ALREADY_COMPLETED', function () { pm.expect(json.error.code).to.eql('ITEM_ALREADY_COMPLETED'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5.14 - Gate blocks moveStage",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-email", "value": "{{userEmail}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/projects/{{projectId}}/move-stage",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"toStageId\": \"{{gatedStageId}}\"\n}"
        },
        "description": "Prerequisito: lo stage di destinazione deve avere isGated=true e gateChecklistTemplateId valorizzato."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status 409', function () { pm.response.to.have.status(409); });",
              "pm.test('code CHECKLIST_GATE_BLOCKED', function () { pm.expect(json.error.code).to.eql('CHECKLIST_GATE_BLOCKED'); });",
              "pm.test('missingRequiredItemIds array', function () { pm.expect(json.error.details.missingRequiredItemIds).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5.15 - Override gate without permission",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "x-user-id", "value": "{{limitedUserId}}" },
          { "key": "x-user-email", "value": "{{limitedUserEmail}}" },
          { "key": "x-workspace-id", "value": "{{workspaceId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": "{{baseUrl}}/projects/{{projectId}}/move-stage",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"toStageId\": \"{{gatedStageId}}\",\n  \"overrideGate\": true,\n  \"overrideReason\": \"Motivazione override valida\"\n}"
        },
        "description": "L'utente deve avere projects.move_stage ma NON checklists.override_gate."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
