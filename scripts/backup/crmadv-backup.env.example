# Configurazione del backup del database di produzione — MODELLO.
#
# Si copia sulla VPS in /etc/crmadv-backup.env e si riempie lì. Quel file contiene dati
# di produzione: va `chmod 600` e non torna mai nel repository (che è pubblico).
#
# ⚠️ La PASSWORD del database NON si scrive qui: sta nel ~/.pgpass dell'utente che esegue
#    il backup, con permessi 600. pg_dump la trova da solo. Vedi README.md.

# --- Database di produzione (Supabase) ------------------------------------------------
# Host: se la VPS non ha IPv6, serve il "pooler" in modalità sessione (porta 5432),
# non il collegamento diretto db.<progetto>.supabase.co, che è solo IPv6.
# ⚠️ La porta 6543 (pooler in modalità transazione) con pg_dump NON funziona.
PGHOST=
PGPORT=5432
PGUSER=
PGDATABASE=postgres
PGSSLMODE=require

# Opzioni extra per pg_dump, di norma vuoto.
# Se Supabase rifiuta la lettura dei suoi schemi di servizio, si restringe ai nostri dati:
#   PG_DUMP_OPZIONI_EXTRA="--schema=public"
PG_DUMP_OPZIONI_EXTRA=

# --- Dove finiscono i file ------------------------------------------------------------
DEST_DIR=/var/backups/crmadv
LOG_FILE=/var/log/crmadv-backup.log
STATO_DIR=/var/lib/crmadv-backup

# --- Quanto si tengono ----------------------------------------------------------------
GIORNALIERI_DA_TENERE=7
SETTIMANALI_DA_TENERE=4
MENSILI_DA_TENERE=3

# --- Controlli sul file prodotto ------------------------------------------------------
# Sotto questa dimensione il dump è un fallimento travestito da successo.
DIMENSIONE_MINIMA_BYTE=1048576
# Calo massimo tollerato rispetto al backup precedente, in percentuale.
CALO_MASSIMO_PERCENTUALE=50

# --- Copia fuori sede (archivio a oggetti) --------------------------------------------
# Chiavi di SOLA SCRITTURA: chi entrasse nella VPS non deve poter cancellare le copie.
# La scadenza dei file la decide la regola del ciclo di vita sull'archivio, non lo script.
RCLONE_REMOTE=
RCLONE_CONFIG=/etc/crmadv-rclone.conf

# --- Sorveglianza ---------------------------------------------------------------------
# Guardiano del silenzio (healthchecks.io o simile): è l'unica cosa che si accorge del
# backup che non gira affatto. Lo script gli manda un segnale quando finisce bene e uno
# di guasto quando fallisce.
HEALTHCHECK_URL=

# Paperclip: apre un compito SOLO quando il backup fallisce. Mai quando va bene.
PAPERCLIP_API_URL=
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=
PAPERCLIP_ASSIGNEE_AGENT_ID=
# Ore minime fra due allarmi: un guasto che dura una settimana apre un compito, non sette.
ORE_FRA_DUE_ALLARMI=20
