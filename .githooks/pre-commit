#!/bin/sh
{
  # LANCIATORE, e basta: avvia il modulo e pretende la sua sentinella prima di
  # credere al suo esito. Tutta la logica — e i commenti che la spiegano — sta in
  # `scripts/hook/pre-commit.mjs` (compito CRMA-152).
  #
  # ⚠️ LE PARENTESI GRAFFE NON SONO UN VEZZO: sono il motivo per cui questo file
  # non si puo' svuotare in silenzio. Un troncamento (checkout interrotto, disco
  # pieno, merge andato male) lascia un blocco `{` mai chiuso, e `sh` allora non
  # esegue NIENTE: errore di sintassi, uscita diversa da zero, commit rifiutato.
  # Senza graffe ogni riga tagliata darebbe uno script piu' corto ma valido, che
  # esce 0 — cioe' un commit accettato senza che nessun controllo sia girato: e'
  # esattamente il guasto misurato in CRMA-102 sull'hook di prima (105 punti di
  # troncamento su 135 accettavano un segreto vero). Per la stessa ragione anche
  # questo commento sta DENTRO le graffe: fuori aggiungerebbe punti scoperti.
  # Restano scoperti i due soli che nessuna forma puo' coprire — il file vuoto e
  # la sola riga di shebang — ed e' il conto che `scripts/hook/pre-commit.test.mjs`
  # ricontrolla a ogni `npm run test:scripts`, riga per riga.
  #
  # Attivazione (una volta per clone):  git config core.hooksPath .githooks
  # Via d'uscita dichiarata:            git commit --no-verify
  if uscita=$(node scripts/hook/pre-commit.mjs); then esito=0; else esito=$?; fi

  case "$uscita" in
    *"pre-commit: arrivato in fondo"*) exit "$esito" ;;
  esac

  # Nessuna sentinella: il modulo non e' arrivato in fondo, o non e' mai partito.
  # I due casi vogliono due messaggi diversi, o si cerca il guasto nel file sbagliato.
  if [ "$esito" -eq 127 ]; then
    echo "[BLOCCO] il controllo pre-commit non ha potuto girare: 'node' non e' stato trovato." >&2
    echo "         Commit rifiutato per prudenza: node e' un requisito del progetto," >&2
    echo "         installalo, oppure, se sei sicuro, usa  git commit --no-verify" >&2
  else
    echo "[BLOCCO] scripts/hook/pre-commit.mjs non e' arrivato in fondo: e' assente," >&2
    echo "         troncato, di soli spazi, o si e' interrotto a meta' (esito $esito)." >&2
    echo "         Nessun controllo e' girato, quindi il commit non e' stato verificato." >&2
    echo "         Commit rifiutato per prudenza: ripristina il file con" >&2
    echo "           git checkout -- scripts/hook/pre-commit.mjs" >&2
    echo "         oppure, se sei sicuro, usa  git commit --no-verify" >&2
  fi
  exit 1
}
