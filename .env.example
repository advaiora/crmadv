# ─────────────────────────────────────────────────────────────────────────────
#  CRM Advaiora — modello del file .env
#
#  COME SI USA
#    1. Copia questo file e chiamalo `.env` (senza `.example`), nella stessa
#       cartella. In PowerShell:  Copy-Item .env.example .env
#    2. Riempi i valori. Qui dentro ci sono SOLO I NOMI: nessun valore vero.
#    3. `.env` e' escluso dal repository (vedi .gitignore) e non va mai committato.
#
#  LEGENDA
#    [OBBLIGATORIA]  senza questa l'API non parte proprio
#    [consigliata]   parte lo stesso, ma qualcosa non funziona come dovrebbe
#    [opzionale]     ha un valore di ripiego sensato, si puo' lasciare fuori
#
#  ⚠️ Le chiavi per la postazione locale te le generi TU: non si copiano da
#     quelle di produzione. Come generarle: archivio-documenti/come-il-crm-sta-online.md
# ─────────────────────────────────────────────────────────────────────────────


# ── 1. Database ──────────────────────────────────────────────────────────────

# [OBBLIGATORIA] Indirizzo del database PostgreSQL. Deve iniziare con postgresql://
DATABASE_URL=

# [opzionale] Motore Prisma. Lascia vuoto: il valore "dataproxy" fa fallire l'avvio apposta.
PRISMA_CLIENT_ENGINE_TYPE=


# ── 2. Avvio dell'API ────────────────────────────────────────────────────────

# [opzionale] Indirizzo su cui l'API si mette in ascolto. Se manca: 0.0.0.0
API_HOST=

# [opzionale] Porta dell'API. Se manca: 4000 (in produzione e' impostata a 3001)
API_PORT=

# [opzionale] "development" in locale, "production" online. Se manca vale sviluppo.
NODE_ENV=

# [opzionale] Solo sviluppo: forza la porta del frontend Vite. Se manca: 5173
PORT=


# ── 3. Accesso e cifratura (le due chiavi che devi generare) ─────────────────

# [OBBLIGATORIA] Firma i token di accesso. Almeno 16 caratteri.
AUTH_JWT_SECRET=

# [opzionale] Durata del token in secondi, fra 60 e 2592000. Se manca: 604800 (7 giorni)
AUTH_JWT_EXPIRES_IN_SECONDS=

# [OBBLIGATORIA] Chiave madre che cifra le credenziali salvate nel CRM.
# Esattamente 32 byte: o 32 caratteri di testo, o 32 byte in base64.
# ⚠️ Se la cambi, tutto cio' che era stato cifrato con la chiave precedente
#    diventa illeggibile e va reinserito a mano dentro il CRM.
ENCRYPTION_KEY=


# ── 4. Chi puo' chiamare l'API (CORS) e a quale indirizzo risponde il CRM ─────

# [consigliata] Elenco di origini separate da virgola, es. l'indirizzo del frontend.
# In sviluppo, se manca, sono ammessi da soli http://localhost:5173 e http://127.0.0.1:5173.
# In produzione, se manca, non e' ammesso NESSUNO e il CRM non riesce a parlare con l'API.
ALLOWED_ORIGINS=

# [consigliata] Indirizzo pubblico del CRM: serve a comporre i link degli inviti al Team.
# In sviluppo, se manca, si usa http://localhost:5173.
APP_BASE_URL=

# [opzionale] Alternative ad APP_BASE_URL per il link d'invito, provate in quest'ordine:
# TEAM_INVITE_BASE_URL, poi APP_BASE_URL, poi FRONTEND_BASE_URL, poi WEB_BASE_URL.
TEAM_INVITE_BASE_URL=
FRONTEND_BASE_URL=
WEB_BASE_URL=


# ── 5. Accesso con Google (facoltativo: si entra comunque con email e password) ──

# [opzionale] Identificativo dell'app Google, lato server. Senza, la rotta /auth/google
# non viene nemmeno registrata e l'API lo segnala all'avvio.
GOOGLE_CLIENT_ID=

# [opzionale] Chi, appena registrato, va promosso ad amministratore di piattaforma.
# Elenco di email separate da virgola. ⚠️ Promuove solo utenti che ESISTONO GIA':
# ci si registra prima, poi si riavvia l'API, e solo allora la promozione avviene.
PLATFORM_ADMIN_EMAILS=


# ── 6. Server di posta (inviti al Team e notifiche preventivi) ───────────────
#
# Queste sei variabili sono TUTTO quello che serve per la posta in uscita: quando
# arrivano le credenziali della casella noreply, si riempiono e basta — non c'e'
# nessun codice da toccare.
#
# ⚠️ Dentro il CRM esiste la pagina Profilo → Server di posta, che salva gli stessi
#    parametri per workspace e HA LA PRECEDENZA su queste variabili. Queste servono
#    al primo avvio, quando nel CRM non c'e' ancora niente.
#
# COSA SUCCEDE SE SMTP_HOST E' VUOTO (e nel CRM non c'e' niente):
#  - in sviluppo si ripiega su una casella finta (Ethereal) che restituisce un link
#    per leggere il messaggio senza recapitarlo a nessuno. Se Ethereal non risponde
#    — macchina scollegata, proxy — il messaggio viene scritto nei log dell'API,
#    con destinatario, oggetto e corpo, e il lavoro va avanti lo stesso;
#  - in produzione NON si ripiega su niente: la posta non parte e nei log dell'API
#    compare una riga di errore che dice chi stava spedendo e verso chi.
#    ⚠️ Nessuno dei due ripieghi viene mai annunciato come "email inviata".

# [opzionale] Indirizzo del server di posta in uscita.
SMTP_HOST=

# [opzionale] Porta del server di posta, tipicamente 587 oppure 465.
SMTP_PORT=

# [opzionale] "false" sulla porta 587, "true" sulla 465.
SMTP_SECURE=

# [opzionale] Nome utente della casella.
SMTP_USER=

# [opzionale] Password della casella. ⚠️ Sta solo qui, non va in nessun documento.
SMTP_PASS=

# [opzionale] Indirizzo che compare come mittente.
# ⚠️ Si chiama EMAIL_FROM, non MAIL_FROM: e' il nome con cui e' nata (18/8/2026) ed
#    e' quello che il codice legge. Rinominarla ora spegnerebbe il mittente su ogni
#    ambiente in cui e' gia' scritta, senza dare errore: il CRM ripiegherebbe in
#    silenzio su "no-reply@local".
EMAIL_FROM=


# ── 7. Vault e conferma d'identita' (step-up) ────────────────────────────────
#
# Si leggono solo quando qualcuno apre il Vault: l'API parte anche senza.
# Se mancano i due segreti, si ripiega su AUTH_JWT_SECRET, quindi vanno bene vuoti.

# [opzionale] Segreto dei token di conferma identita'. Almeno 16 caratteri.
STEP_UP_TOKEN_SECRET=
# [opzionale] Durata in secondi del token di conferma identita'.
STEP_UP_TTL_SECONDS=
# [opzionale] Nome, percorso e comportamento del cookie di conferma identita'.
STEP_UP_COOKIE_NAME=
STEP_UP_COOKIE_PATH=
STEP_UP_COOKIE_SAME_SITE=
# [opzionale] "true"/"false". Se manca: true solo quando NODE_ENV vale "production".
STEP_UP_COOKIE_SECURE=
# [opzionale] Quanto puo' essere vecchio un login Google per valere come conferma.
STEP_UP_OAUTH_RECENT_LOGIN_MAX_AGE_SECONDS=

# [opzionale] Segreto dei token di sblocco del Vault. Almeno 16 caratteri.
VAULT_UNLOCK_TOKEN_SECRET=
# [opzionale] Durata in secondi dello sblocco del Vault.
VAULT_UNLOCK_TTL_SECONDS=
# [opzionale] Nome, percorso e comportamento del cookie di sblocco del Vault.
VAULT_UNLOCK_COOKIE_NAME=
VAULT_UNLOCK_COOKIE_PATH=
VAULT_UNLOCK_COOKIE_SAME_SITE=
VAULT_UNLOCK_COOKIE_SECURE=

# [opzionale] Segreto dei token d'invito al Team. Se manca si ripiega su AUTH_JWT_SECRET.
TEAM_INVITE_TOKEN_SECRET=


# ── 8. Intelligenza artificiale (area Agency) ────────────────────────────────
#
# ⚠️ Le chiavi AI si inseriscono normalmente DENTRO il CRM, in Impostazioni →
#    AI e Ricerca Competitor: li' vengono salvate cifrate. Il codice legge prima
#    il database e solo dopo queste variabili. Lasciarle vuote e' la scelta giusta.
#    ⚠️ Non metterci un segnaposto tipo REPLACE_ME: un valore finto ma non vuoto
#       viene creduto valido e fa fallire le chiamate con un errore del fornitore.

# [opzionale] Accende l'AI dell'area Agency: "true" per accendere. Se manca: spenta.
AGENCY_AI_ENABLED=
# [opzionale] Fornitore: "openai" oppure "anthropic". Se manca: "none".
AGENCY_AI_PROVIDER=
# [opzionale] Modello da usare. Se manca: gpt-4o-mini
AGENCY_AI_MODEL=
# [opzionale] Modalita' predefinita. Se manca: "quick"
AGENCY_AI_DEFAULT_MODE=
# [opzionale] Tempo massimo di attesa in millisecondi. Se manca: 45000
AGENCY_AI_TIMEOUT_MS=
# [opzionale] Tetto di token in uscita. Se manca: 0 (nessun tetto imposto qui)
AGENCY_AI_MAX_OUTPUT_TOKENS=
# [opzionale] Tetti di caratteri in ingresso. Se mancano: 24000, 2200, 1200
AGENCY_AI_INPUT_MAX_CHARS=
AGENCY_AI_STRING_MAX_CHARS=
AGENCY_AI_FILE_TEXT_MAX_CHARS=
# [opzionale] Traccia di diagnostica: "true" per accendere. Se manca: spenta.
AGENCY_AI_DEBUG_ENABLED=

# [opzionale] Ricerca competitor: "true" per accendere. Se manca: spenta.
AGENCY_COMPETITOR_SEARCH_ENABLED=
# [opzionale] Fornitore della ricerca: "openai" oppure "anthropic". Se manca: "none".
AGENCY_COMPETITOR_SEARCH_PROVIDER=
# [opzionale] Modello della ricerca competitor.
AGENCY_COMPETITOR_SEARCH_MODEL=
# [opzionale] Tempo massimo di attesa in millisecondi. Se manca: 180000
AGENCY_COMPETITOR_SEARCH_TIMEOUT_MS=

# [opzionale] Chiavi dei fornitori AI, usate solo come ripiego se il CRM non le ha.
# ⚠️ Valori veri, mai in un documento e mai nel repository.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=


# ── 9. Frontend (le variabili VITE_) ─────────────────────────────────────────
#
# ⚠️ Vengono incise dentro il pacchetto AL MOMENTO DELLA COMPILAZIONE, non lette
#    mentre gira. Se le cambi devi rifare `npm run build` (online: un nuovo deploy).

# [consigliata] Indirizzo dell'API vista dal browser, es. http://localhost:4000
# Se la lasci vuota si usa "/api", che in sviluppo funziona lo stesso perche' Vite
# gira le chiamate all'API da solo. ⚠️ Va scritto l'indirizzo NUDO, senza "/api"
# in fondo: la maggior parte delle rotte dell'API non ha quel prefisso.
VITE_API_URL=

# [opzionale] Vecchio nome alternativo di VITE_API_URL. Non impostare tutte e due:
# se ci sono entrambe vince VITE_API_URL.
VITE_API_BASE_URL=

# [opzionale] Identificativo dell'app Google lato browser: stesso valore di
# GOOGLE_CLIENT_ID. ⚠️ Il pulsante "Accesso Google" si vede comunque: senza questa
# variabile fallisce dopo il clic. Con email e password si entra normalmente.
VITE_GOOGLE_CLIENT_ID=

# [opzionale] Indirizzo di ritorno dopo l'accesso Google.
VITE_GOOGLE_REDIRECT_URI=

# [opzionale] "true" per stampare la risposta grezza di Google. Solo per diagnosi.
VITE_GOOGLE_DEBUG_RAW_RESPONSE=

# [opzionale] Solo in sviluppo: workspace usato in automatico. Se manca: "demo"
VITE_DEV_WORKSPACE_SLUG=
