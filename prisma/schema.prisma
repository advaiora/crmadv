model Quote {
  id              String          @id @default(cuid())
  workspaceId     String
  clientId        String
  projectId       String?
  templateId      String?
  createdByUserId String?
  status          QuoteStatus     @default(DRAFT)
  currency        String          @default("EUR") @db.VarChar(3)
  subtotal        Decimal         @db.Decimal(12, 2)
  taxTotal        Decimal         @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)
  taxRate         Decimal?        @db.Decimal(5, 2)
  issueDate       DateTime?
  validUntil      DateTime?
  notes           String?
  internalNotes   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  template        QuoteTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdByUser   User?           @relation("QuoteCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items           QuoteItem[]
  emailLogs       QuoteEmailLog[]

  @@index([workspaceId, status])
  @@index([workspaceId, clientId])
  @@index([workspaceId, projectId])
  @@index([workspaceId, templateId])
}

model QuoteItem {
  id            String             @id @default(cuid())
  workspaceId   String
  quoteId       String
