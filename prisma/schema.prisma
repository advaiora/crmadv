generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuoteStatus {
  draft
  sent
  accepted
}

enum QuoteEmailLogType {
  send
  resend
}

enum EmailSendStatus {
  success
  fail
}

enum ClientType {
  person
  company
}

enum ChecklistInstanceStatus {
  active
  completed
  archived
}

enum ChecklistItemState {
  pending
  completed
  not_applicable
}

model Workspace {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  memberships            Membership[]
  clients                Client[]
  workspaceModules       WorkspaceModule[]
  roles                  Role[]
  userRoles              UserRole[]
  branding               WorkspaceBranding?
  quotes                 Quote[]
  quoteEmailLogs         QuoteEmailLog[]
  auditLogs              AuditLog[]
  checklistTemplates     ChecklistTemplate[]
  checklistTemplateItems ChecklistTemplateItem[]
  stageChecklistRules    StageChecklistRule[]
  checklistInstances     ChecklistInstance[]
  checklistInstanceItems ChecklistInstanceItem[]
}

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  name                    String?
  passwordHash            String?
  role                    String                  @default("member")
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  memberships             Membership[]
  userRoles               UserRole[]
  auditLogs               AuditLog[]              @relation("AuditActor")
  completedChecklistItems ChecklistInstanceItem[]
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model Client {
  id          String     @id @default(cuid())
  workspaceId String
  type        ClientType @default(person)
  name        String
  email       String?
  phone       String?
  vatNumber   String?
  taxCode     String?
  street      String?
  city        String?
  zip         String?
  province    String?
  country     String?
  notes       String?
  tags        String[]   @default([])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quotes      Quote[]

  @@index([workspaceId, name])
  @@index([workspaceId, email])
  @@index([workspaceId, phone])
  @@index([workspaceId, updatedAt])
}

model ChecklistTemplate {
  id          String                  @id @default(cuid())
  workspaceId String
  name        String
  description String?
  isArchived  Boolean                 @default(false)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items       ChecklistTemplateItem[]
  stageRules  StageChecklistRule[]
  instances   ChecklistInstance[]

  @@index([workspaceId, name])
}

model ChecklistTemplateItem {
  id               String                  @id @default(cuid())
  workspaceId      String
  templateId       String
  title            String
  description      String?
  sortOrder        Int                     @default(0)
  isRequired       Boolean                 @default(true)
  requiresEvidence Boolean                 @default(false)
  isCritical       Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template         ChecklistTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  instanceItems    ChecklistInstanceItem[]

  @@index([templateId, sortOrder])
  @@index([workspaceId])
}

model StageChecklistRule {
  id                  String            @id @default(cuid())
  workspaceId         String
  pipelineStageId     String
  checklistTemplateId String
  isBlocking          Boolean           @default(true)
  autoCreateInstance  Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  checklistTemplate   ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, pipelineStageId])
  @@index([workspaceId])
}

model ChecklistInstance {
  id                  String                  @id @default(cuid())
  workspaceId         String
  projectId           String
  pipelineStageId     String?
  checklistTemplateId String
  status              ChecklistInstanceStatus @default(active)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  workspace           Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  checklistTemplate   ChecklistTemplate       @relation(fields: [checklistTemplateId], references: [id], onDelete: Restrict)
  items               ChecklistInstanceItem[]

  @@unique([workspaceId, projectId, pipelineStageId, checklistTemplateId])
  @@index([workspaceId, projectId])
}

model ChecklistInstanceItem {
  id                       String                @id @default(cuid())
  workspaceId              String
  instanceId               String
  templateItemId           String
  titleSnapshot            String
  isRequiredSnapshot       Boolean
  requiresEvidenceSnapshot Boolean
  isCriticalSnapshot       Boolean
  sortOrderSnapshot        Int
  state                    ChecklistItemState    @default(pending)
  evidenceNote             String?
  evidenceUrl              String?
  notApplicableReason      String?
  completedAt              DateTime?
  completedByUserId        String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  workspace                Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instance                 ChecklistInstance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  templateItem             ChecklistTemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Restrict)
  completedByUser          User?                 @relation(fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([instanceId, sortOrderSnapshot])
  @@index([workspaceId])
}

model Module {
  id               String            @id @default(cuid())
  key              String            @unique
  name             String
  description      String?
  isCore           Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  workspaceModules WorkspaceModule[]
  permissions      Permission[]
}

model WorkspaceModule {
  id          String    @id @default(cuid())
  workspaceId String
  moduleId    String
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, moduleId])
  @@index([workspaceId])
  @@index([moduleId])
}

model Role {
  id              String           @id @default(cuid())
  workspaceId     String
  name            String
  description     String?
  isSystem        Boolean          @default(false)
  isSuperadmin    Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  moduleId        String?
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  module          Module?          @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  rolePermissions RolePermission[]

  @@index([moduleId])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  roleId      String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, roleId])
  @@index([workspaceId, userId])
  @@index([roleId])
}

model WorkspaceBranding {
  id             String    @id @default(cuid())
  workspaceId    String    @unique
  workspaceName  String?
  logoUrl        String?
  supportEmail   String?
  primaryColor   String    @default("#0d6efd")
  secondaryColor String    @default("#6c757d")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Quote {
  id          String          @id @default(cuid())
  workspaceId String
  clientId    String?
  clientName  String
  clientEmail String?
  clientPhone String?
  status      QuoteStatus     @default(draft)
  total       Decimal         @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lines       QuoteLine[]
  emailLogs   QuoteEmailLog[]

  @@index([workspaceId, status])
}

model QuoteLine {
  id        String   @id @default(cuid())
  quoteId   String
  title     String
  qty       Int      @default(1)
  unitPrice Decimal  @db.Decimal(12, 2)
  lineTotal Decimal? @db.Decimal(12, 2)
  order     Int?
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model QuoteEmailLog {
  id                String            @id @default(cuid())
  workspaceId       String
  quoteId           String
  type              QuoteEmailLogType
  toMasked          String
  ccCount           Int               @default(0)
  bccCount          Int               @default(0)
  subject           String?
  downloadName      String?
  provider          String
  providerMessageId String?
  status            EmailSendStatus
  errorCode         String?
  errorMessage      String?           @db.VarChar(300)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quote             Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([workspaceId, quoteId, createdAt])
  @@index([quoteId])
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  actorUserId String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorUser   User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorUserId])
  @@index([action])
}
