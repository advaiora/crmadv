model WorkspaceModule {
  id          String    @id @default(cuid())
  workspaceId String
  moduleId    String
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, moduleId])
  @@index([workspaceId])
  @@index([moduleId])
}

model Role {
  id              String           @id @default(cuid())
  workspaceId     String
  name            String
  description     String?
  isSystem        Boolean          @default(false)
  isSuperadmin    Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  moduleId        String?
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  module          Module?          @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  rolePermissions RolePermission[]

  @@index([moduleId])
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  roleId      String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, roleId])
  @@index([workspaceId, userId])
  @@index([roleId])
}

model Department {
  id          String             @id @default(cuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     DepartmentMember[]
  projects    ProjectDepartment[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model DepartmentMember {
  id           String     @id @default(cuid())
  workspaceId  String
  departmentId String
  userId       String
  role         String     @default("member")
  createdAt    DateTime   @default(now())
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([departmentId])
}

model ProjectDepartment {
  id           String     @id @default(cuid())
  workspaceId  String
  projectId    String
  departmentId String
  createdAt    DateTime   @default(now())
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([projectId, departmentId])
  @@index([workspaceId])
  @@index([departmentId])
  @@index([projectId])
}

model ProjectAccess {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String
  userId      String
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([projectId])
}

model WorkspaceBranding {
  id              String    @id @default(cuid())
  workspaceId     String    @unique
  workspaceName   String?
  logoUrl         String?
  supportEmail    String?
  supportPhone    String?
  supportAddress  String?
  pdfSignatureUrl String?
  primaryColor    String    @default("#0d6efd")
  secondaryColor  String    @default("#6c757d")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model QuoteNotificationSettings {
  id              String    @id @default(cuid())
  workspaceId     String    @unique
  enabled         Boolean   @default(true)
  sentSubject     String?
  sentBody        String?
  acceptedSubject String?
  acceptedBody    String?
  rejectedSubject String?
  rejectedBody    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Quote {
  id              String          @id @default(cuid())
  workspaceId     String
  clientId        String
  projectId       String?
  templateId      String?
  createdByUserId String?
  status          QuoteStatus     @default(DRAFT)
  currency        String          @default("EUR") @db.VarChar(3)
  subtotal        Decimal         @db.Decimal(12, 2)
  taxTotal        Decimal         @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)
  taxRate         Decimal?        @db.Decimal(5, 2)
  issueDate       DateTime?
  validUntil      DateTime?
  notes           String?
  internalNotes   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client          Client          @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  template        QuoteTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdByUser   User?           @relation("QuoteCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items           QuoteItem[]
  emailLogs       QuoteEmailLog[]

  @@index([workspaceId, status])
  @@index([workspaceId, clientId])
  @@index([workspaceId, projectId])
  @@index([workspaceId, templateId])
}

model QuoteItem {
  id            String             @id @default(cuid())
  workspaceId   String
  quoteId       String
  position      Int
  title         String
  description   String?
  quantity      Decimal            @db.Decimal(12, 2)
  unitPrice     Decimal            @db.Decimal(12, 2)
  discountType  QuoteDiscountType?
  discountValue Decimal?           @db.Decimal(12, 2)
  lineTotal     Decimal            @db.Decimal(12, 2)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quote         Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([workspaceId, quoteId])
  @@index([quoteId, position])
}

model QuoteTemplate {
  id           String              @id @default(cuid())
  workspaceId  String
  name         String
  description  String?
  defaultNotes String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items        QuoteTemplateItem[]
  quotes       Quote[]

  @@unique([workspaceId, name])
  @@index([workspaceId, updatedAt])
}

model QuoteTemplateItem {
  id            String             @id @default(cuid())
  workspaceId   String
  templateId    String
  position      Int
  title         String
  description   String?
  quantity      Decimal            @db.Decimal(12, 2)
  unitPrice     Decimal            @db.Decimal(12, 2)
  discountType  QuoteDiscountType?
  discountValue Decimal?           @db.Decimal(12, 2)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template      QuoteTemplate      @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([workspaceId, templateId])
  @@index([templateId, position])
}

model QuoteEmailLog {
  id                String            @id @default(cuid())
  workspaceId       String
  quoteId           String
  type              QuoteEmailLogType
  toMasked          String
  ccCount           Int               @default(0)
  bccCount          Int               @default(0)
  subject           String?
  downloadName      String?
  provider          String
  providerMessageId String?
  status            EmailSendStatus
  errorCode         String?
  errorMessage      String?           @db.VarChar(300)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quote             Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([workspaceId, quoteId, createdAt])
  @@index([quoteId])
}

model CalendarEvent {
  id              String    @id @default(cuid())
  workspaceId     String
  createdByUserId String?
  updatedByUserId String?
  title           String
  description     String?
  location        String?
  category        String?   @db.VarChar(60)
  color           String?   @db.VarChar(20)
  startAt         DateTime
  endAt           DateTime?
  allDay          Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdByUser   User?     @relation("CalendarEventCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?     @relation("CalendarEventUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, startAt])
  @@index([workspaceId, updatedAt])
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  actorUserId String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorUser   User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorUserId])
  @@index([action])
}

model WorkspaceMessage {
  id              String    @id @default(cuid())
  workspaceId     String
  senderUserId    String
  recipientUserId String
  body            String    @db.VarChar(4000)
  readAt          DateTime?
  createdAt       DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  senderUser      User      @relation("WorkspaceMessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  recipientUser   User      @relation("WorkspaceMessageRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([workspaceId, senderUserId, recipientUserId, createdAt(sort: Desc)])
  @@index([workspaceId, recipientUserId, readAt, createdAt(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc)])
}

model VaultItem {
  id              String    @id @default(cuid())
  workspaceId     String
  clientId        String?
  name            String    @db.VarChar(255)
  username        String?   @db.VarChar(255)
  url             String?   @db.VarChar(2048)
  tags            String[]  @default([])
  ciphertext      String    @db.Text
  iv              String    @db.VarChar(255)
  authTag         String    @db.VarChar(255)
  version         Int       @default(1)
  keyVersion      Int       @default(1)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdByUser   User?     @relation("VaultItemCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser   User?     @relation("VaultItemUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, clientId])
  @@index([workspaceId, name])
  @@index([workspaceId, keyVersion])
  @@index([workspaceId, updatedAt(sort: Desc)])
  @@index([createdByUserId])
  @@index([updatedByUserId])
}

model WorkspaceVaultKey {
  id          String    @id @default(cuid())
  workspaceId String
  wrappedKey  String    @db.Text
  iv          String?   @db.VarChar(255)
  authTag     String?   @db.VarChar(255)
  keyVersion  Int       @default(1)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, keyVersion])
  @@index([workspaceId, isActive])
}

model WorkspaceVaultPolicy {
  id                 String    @id @default(cuid())
  workspaceId        String    @unique
  masterPasswordHash String    @db.VarChar(255)
  passwordVersion    Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, updatedAt(sort: Desc)])
}
