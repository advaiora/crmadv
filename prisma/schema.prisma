generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum QuoteDiscountType {
  PERCENT
  FIXED
}

enum QuoteEmailLogType {
  send
  resend
}

enum EmailSendStatus {
  success
  fail
}

enum ClientType {
  person
  company
}

// Tipo di un campo personalizzato (Custom Fields, V3). Determina come si
// renderizza nel form e come si valida il valore.
enum CustomFieldType {
  text
  textarea
  number
  date
  boolean
  select
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum WebAssetStatus {
  ACTIVE
  MAINTENANCE
  PAUSED
  ARCHIVED
}

enum WebAssetVersionStatus {
  DRAFT
  STAGED
  LIVE
}

enum WebAssetDeploymentEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum WebAssetHealthStatus {
  UP
  DEGRADED
  DOWN
}

enum WebAssetMaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum WebAssetAlertType {
  DOWNTIME
  PERFORMANCE
  ERROR_RATE
  MAINTENANCE
}

enum WebAssetAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum WebAssetAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ChecklistTemplateAppliesTo {
  PROJECT_STAGE
  WEB_ASSET_STATUS
}

enum AgencyProjectStatus {
  DISCOVERY
  PLANNING
  PRODUCTION
  REVIEW
  LIVE
  PAUSED
  ARCHIVED
}

enum AgencyPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectAlertSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ProjectAlertStatus {
  OPEN
  MONITORING
  RESOLVED
  SUGGESTED
}

enum ProjectOpportunityStatus {
  OPEN
  PROPOSED
  WON
  LOST
  SUGGESTED
}

model Workspace {
  id                         String                      @id @default(cuid())
  name                       String
  slug                       String                      @unique
  status                     WorkspaceStatus             @default(ACTIVE)
  suspendedAt                DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  memberships                Membership[]
  teamInvites                TeamInvite[]
  clients                    Client[]
  customFieldDefinitions     CustomFieldDefinition[]
  workspaceModules           WorkspaceModule[]
  roles                      Role[]
  userRoles                  UserRole[]
  departments                Department[]
  departmentMembers          DepartmentMember[]
  branding                   WorkspaceBranding?
  quoteNotificationSettings  QuoteNotificationSettings?
  projects                   Project[]
  aiBudgets                  AiBudget[]
  projectCategories          ProjectCategory[]
  pipelineStages             PipelineStage[]
  quotes                     Quote[]
  quoteItems                 QuoteItem[]
  quoteTemplates             QuoteTemplate[]
  quoteTemplateItems         QuoteTemplateItem[]
  quoteEmailLogs             QuoteEmailLog[]
  calendarEvents             CalendarEvent[]
  websiteAssets              WebsiteAsset[]
  webAppAssets               WebAppAsset[]
  ecommerceAssets            EcommerceAsset[]
  webAssetVersions           WebAssetVersion[]
  webAssetHealthChecks       WebAssetHealthCheck[]
  webAssetSeoReports         WebAssetSeoReport[]
  webAssetAnalyticsSnapshots WebAssetAnalyticsSnapshot[]
  webAssetAnalyticsEvents    WebAssetAnalyticsEvent[]
  webAssetMaintenanceWindows WebAssetMaintenanceWindow[]
  webAssetAlerts             WebAssetAlert[]
  auditLogs                  AuditLog[]
  workspaceMessages          WorkspaceMessage[]
  vaultItems                 VaultItem[]
  vaultKeys                  WorkspaceVaultKey[]
  vaultPolicy                WorkspaceVaultPolicy?
  checklistTemplates         ChecklistTemplate[]
  checklistTemplateItems     ChecklistTemplateItem[]
  checklistInstances         ChecklistInstance[]
  checklistInstanceItems     ChecklistInstanceItem[]
  stageChecklistRules        StageChecklistRule[]
  projectTypes               ProjectType[]
  projectActiveModules       ProjectActiveModule[]
  projectMemories            ProjectMemory[]
  projectAlerts              ProjectAlert[]
  projectOpportunities       ProjectOpportunity[]
  projectTasks               ProjectTask[]
  agencyRuntimeSettings      AgencyRuntimeSetting[]
  aiUsageLogs                AiUsageLog[]
  integrations               Integration[]
  projectSources             ProjectSource[]
  aiConversations            AiConversation[]
  aiConversationParticipants AiConversationParticipant[]
  aiConversationMessages     AiConversationMessage[]
  aiConversationAttachments  AiConversationAttachment[]
}

model User {
  id                                    String                      @id @default(cuid())
  email                                 String                      @unique
  googleSub                             String?                     @unique
  name                                  String?
  passwordHash                          String?
  vaultPasswordHash                     String?
  role                                  String                      @default("member")
  isPlatformAdmin                       Boolean                     @default(false)
  themePreference                       String?                     @db.VarChar(10)
  avatarUrl                             String?                     @db.Text
  createdAt                             DateTime                    @default(now())
  updatedAt                             DateTime                    @updatedAt
  memberships                           Membership[]
  teamInvitesSent                       TeamInvite[]                @relation("TeamInviteInvitedByUser")
  teamInvitesAccepted                   TeamInvite[]                @relation("TeamInviteAcceptedByUser")
  userRoles                             UserRole[]
  departmentMembers                     DepartmentMember[]
  ownedProjects                         Project[]                   @relation("ProjectOwner")
  projectAccess                         ProjectAccess[]
  createdQuotes                         Quote[]                     @relation("QuoteCreatedByUser")
  createdCalendarEvents                 CalendarEvent[]             @relation("CalendarEventCreatedByUser")
  updatedCalendarEvents                 CalendarEvent[]             @relation("CalendarEventUpdatedByUser")
  ownedWebsiteAssets                    WebsiteAsset[]              @relation("WebsiteAssetOwner")
  ownedWebAppAssets                     WebAppAsset[]               @relation("WebAppAssetOwner")
  ownedEcommerceAssets                  EcommerceAsset[]            @relation("EcommerceAssetOwner")
  createdWebAssetVersions               WebAssetVersion[]           @relation("WebAssetVersionCreatedByUser")
  createdWebAssetHealthChecks           WebAssetHealthCheck[]       @relation("WebAssetHealthCheckCreatedByUser")
  createdWebAssetSeoReports             WebAssetSeoReport[]         @relation("WebAssetSeoReportCreatedByUser")
  createdWebAssetAnalyticsSnapshots     WebAssetAnalyticsSnapshot[] @relation("WebAssetAnalyticsSnapshotCreatedByUser")
  createdWebAssetAnalyticsEvents        WebAssetAnalyticsEvent[]    @relation("WebAssetAnalyticsEventCreatedByUser")
  createdWebAssetMaintenanceWindows     WebAssetMaintenanceWindow[] @relation("WebAssetMaintenanceWindowCreatedByUser")
  updatedWebAssetMaintenanceWindows     WebAssetMaintenanceWindow[] @relation("WebAssetMaintenanceWindowUpdatedByUser")
  createdWebAssetAlerts                 WebAssetAlert[]             @relation("WebAssetAlertCreatedByUser")
  sentWorkspaceMessages                 WorkspaceMessage[]          @relation("WorkspaceMessageSender")
  receivedWorkspaceMessages             WorkspaceMessage[]          @relation("WorkspaceMessageRecipient")
  createdVaultItems                     VaultItem[]                 @relation("VaultItemCreatedByUser")
  updatedVaultItems                     VaultItem[]                 @relation("VaultItemUpdatedByUser")
  auditLogs                             AuditLog[]                  @relation("AuditActor")
  completedChecklistItems               ChecklistInstanceItem[]     @relation("ChecklistItemCompletedByUser")
  assignedChecklistItems                ChecklistInstanceItem[]     @relation("ChecklistItemAssignedToUser")
  assignedChecklistItemsBy              ChecklistInstanceItem[]     @relation("ChecklistItemAssignedByUser")
  defaultAssignedChecklistTemplateItems ChecklistTemplateItem[]     @relation("ChecklistTemplateItemDefaultAssignedToUser")
  aiUsageLogs                           AiUsageLog[]
  createdAiConversations                AiConversation[]            @relation("AiConversationCreatedBy")
  aiConversationParticipations          AiConversationParticipant[] @relation("AiConversationParticipantUser")
  aiConversationInvitesSent             AiConversationParticipant[] @relation("AiConversationParticipantInvitedBy")
  authoredAiMessages                    AiConversationMessage[]     @relation("AiConversationMessageAuthor")
  createdAiAttachments                  AiConversationAttachment[]  @relation("AiConversationAttachmentCreatedBy")
}

model TeamInvite {
  id               String           @id @default(cuid())
  workspaceId      String
  email            String           @db.VarChar(320)
  tokenHash        String           @unique @db.VarChar(128)
  expiresAt        DateTime
  status           TeamInviteStatus @default(PENDING)
  rolePresetName   String?          @db.VarChar(60)
  invitedByUserId  String
  acceptedByUserId String?
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedByUser    User             @relation("TeamInviteInvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedByUser   User?            @relation("TeamInviteAcceptedByUser", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([workspaceId, email, status])
  @@index([workspaceId, expiresAt])
}

model Membership {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model Client {
  id              String           @id @default(cuid())
  workspaceId     String
  type            ClientType       @default(person)
  name            String
  email           String?
  phone           String?
  vatNumber       String?
  taxCode         String?
  street          String?
  city            String?
  zip             String?
  province        String?
  country         String?
  notes           String?
  tags            String[]         @default([])
  // Valori dei campi personalizzati del workspace, mappa { chiaveCampo: valore }.
  // Le definizioni dei campi stanno in CustomFieldDefinition (V3).
  customFields    Json             @default("{}")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quotes          Quote[]
  projects        Project[]
  projectLinks    ProjectClient[]
  websiteAssets   WebsiteAsset[]   @relation("WebsiteAssetClient")
  webAppAssets    WebAppAsset[]    @relation("WebAppAssetClient")
  ecommerceAssets EcommerceAsset[] @relation("EcommerceAssetClient")
  vaultItems      VaultItem[]
  aiConversations AiConversation[]

  @@index([workspaceId, name])
  @@index([workspaceId, email])
  @@index([workspaceId, phone])
  @@index([workspaceId, updatedAt])
}

// Definizione di un campo personalizzato per workspace (Custom Fields, V3).
// I valori compilati stanno nella colonna JSON dell'entità (es. Client.customFields),
// mappati per `key`. Per ora l'unica entità supportata è "client".
model CustomFieldDefinition {
  id          String          @id @default(cuid())
  workspaceId String
  entity      String          @default("client") @db.VarChar(40)
  key         String          @db.VarChar(60)
  label       String          @db.VarChar(120)
  type        CustomFieldType @default(text)
  // Per i campi "select": array JSON di opzioni [{ value, label }].
  options     Json?
  required    Boolean         @default(false)
  order       Int             @default(0)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, entity, key])
  @@index([workspaceId, entity, order])
}

model Project {
  id                   String                @id @default(cuid())
  workspaceId          String
  clientId             String?
  name                 String
  description          String?
  value                Float?
  dueDate              DateTime?
  pipelineStageId      String?
  projectTypeId        String?
  goal                 String?
  scopePurchased       Json?
  statusAgency         AgencyProjectStatus   @default(DISCOVERY)
  priorityAgency       AgencyPriority        @default(MEDIUM)
  ownerUserId          String?
  startDate            DateTime?
  endDate              DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client               Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientLinks          ProjectClient[]
  pipelineStage        PipelineStage?        @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  projectType          ProjectType?          @relation(fields: [projectTypeId], references: [id], onDelete: SetNull)
  quotes               Quote[]
  websiteAssets        WebsiteAsset[]        @relation("WebsiteAssetProject")
  webAppAssets         WebAppAsset[]         @relation("WebAppAssetProject")
  ecommerceAssets      EcommerceAsset[]      @relation("EcommerceAssetProject")
  activeModules        ProjectActiveModule[]
  projectMemory        ProjectMemory?
  projectAlerts        ProjectAlert[]
  projectOpportunities ProjectOpportunity[]
  projectTasks         ProjectTask[]
  sources              ProjectSource[]
  aiConversations      AiConversation[]
  aiUsageLogs          AiUsageLog[]
  ownerUser            User?                 @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  departments          ProjectDepartment[]
  access               ProjectAccess[]

  @@index([workspaceId, name])
  @@index([workspaceId, clientId])
  @@index([workspaceId, pipelineStageId])
  @@index([workspaceId, projectTypeId])
  @@index([workspaceId, updatedAt])
}

model ProjectType {
  id          String    @id @default(cuid())
  workspaceId String
  key         String
  label       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects    Project[]

  @@unique([workspaceId, key])
  @@index([workspaceId, label])
}

model ProjectActiveModule {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String
  moduleKey   String
  moduleLabel String?
  included    Boolean   @default(false)
  suggested   Boolean   @default(false)
  active      Boolean   @default(false)
  source      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, moduleKey])
  @@index([workspaceId, projectId])
}

model ProjectMemory {
  id             String    @id @default(cuid())
  workspaceId    String
  projectId      String    @unique
  briefJson      Json?
  sourcesJson    Json?
  webJson        Json?
  adsJson        Json?
  diagnosisJson  Json?
  reportsJson    Json?
  contextSummary String?
  memorySummary  Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId])
}

// Fonte di un progetto (V4 — Modulo Fonti). Una riga per fonte: URL, file
// caricato o testo incollato. `content` conserva il testo estratto/normalizzato,
// base per la futura vettorizzazione (embeddings) quando pgvector sarà disponibile.
model ProjectSource {
  id           String    @id @default(cuid())
  workspaceId  String
  projectId    String
  type         String    @db.VarChar(20)
  title        String    @db.VarChar(200)
  url          String?   @db.Text
  fileName     String?   @db.VarChar(255)
  mimeType     String?   @db.VarChar(120)
  fileSize     Int?
  content      String?   @db.Text
  contentChars Int       @default(0)
  status       String    @default("pending") @db.VarChar(20)
  error        String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks       ProjectSourceChunk[]

  @@index([workspaceId, projectId])
  @@index([projectId, createdAt])
}

// Spezzone vettorizzato di una fonte (V4 — RAG). Ogni riga è un blocco di testo
// della fonte con il suo embedding (pgvector, 1536 dim = OpenAI text-embedding-3-small).
// La ricerca semantica ordina per distanza coseno (operatore `<=>`). Gli embedding
// si scrivono/leggono via SQL raw perché Prisma non gestisce nativamente il tipo
// `vector`. Per ora ricerca esatta (full scan): sui volumi per-progetto è istantanea;
// un indice ANN (hnsw) andrà aggiunto quando i dati cresceranno.
model ProjectSourceChunk {
  id          String                      @id @default(cuid())
  workspaceId String
  projectId   String
  sourceId    String
  chunkIndex  Int
  content     String                      @db.Text
  embedding   Unsupported("vector(1536)")
  createdAt   DateTime                    @default(now())
  source      ProjectSource               @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, chunkIndex])
  @@index([workspaceId, projectId])
}

// Conversazione AI collaborativa (post-V4 — Chat AI collaborativa).
// Evoluzione della vecchia ProjectChatMessage (che era per-utente) verso una
// chat CONDIVISA con un concetto di "ambito" (scope): 'project' (una conversazione
// per progetto), 'client' (una per cliente, Fase 2) o 'general' (una per workspace,
// senza contesto CRM). Condivisa tra i partecipanti invitati. L'unicita' per progetto
// e per cliente e' garantita dai vincoli sotto (i NULL non collidono in Postgres);
// per 'general' (projectId e clientId entrambi null) l'unicita' per workspace e'
// gestita a livello applicativo nel repository (get-or-create con findFirst).
// Conversazione ("sessione") della Chat AI. Un AMBITO (progetto/cliente/generale)
// ha N sessioni, non una sola: l'elenco e' quello che l'utente sceglie all'apertura
// della chat, come nelle UI dei chat LLM. Fino al 15/7/2026 valevano @@unique([projectId])
// e @@unique([clientId]) — una chat sola per ambito — con l'effetto che chi non apriva
// per primo restava fuori (non partecipante => zero messaggi e scrittura negata).
// Vedi spec-chat-ai-collaborativa.md sez. 4-bis.
model AiConversation {
  id              String                      @id @default(cuid())
  workspaceId     String
  scope           String                      @default("project") @db.VarChar(16)
  projectId       String?
  clientId        String?
  title           String?                     @db.VarChar(200)
  createdByUserId String?
  // Ultimo messaggio: ordina l'elenco delle sessioni. Denormalizzato di proposito
  // (aggiornato all'invio) per non fare un max(createdAt) sui messaggi per riga.
  lastMessageAt   DateTime?
  // Valorizzato quando la sessione nasce da "Riprendi in una nuova chat" su una
  // sessione congelata: tiene la traccia dell'originale da cui e' stata copiata.
  resumedFromConversationId String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  workspace       Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project?                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client          Client?                     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdByUser   User?                       @relation("AiConversationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  resumedFrom     AiConversation?             @relation("AiConversationResumedFrom", fields: [resumedFromConversationId], references: [id], onDelete: SetNull)
  resumedBy       AiConversation[]            @relation("AiConversationResumedFrom")
  participants    AiConversationParticipant[]
  messages        AiConversationMessage[]
  attachments     AiConversationAttachment[]
  aiUsageLogs     AiUsageLog[]

  @@index([workspaceId, scope])
  @@index([workspaceId, projectId])
  @@index([workspaceId, clientId])
  @@index([resumedFromConversationId])
}

// Partecipante a una conversazione (Fase 1 — condivisione su invito esplicito).
// Una riga per utente ammesso. Il ruolo distingue chi gestisce la SESSIONE
// ('owner': rimuove i membri e scioglie il gruppo) dagli invitati ('member').
// L'owner e' relativo alla singola sessione, non all'ambito: non "possiede" il
// progetto, e puo' uscire come chiunque altro (la gestione passa a chi resta).
//
// frozenAt (15/7/2026) — chi lascia un gruppo NON viene cancellato, viene CONGELATO:
// che esca da solo, che lo rimuova l'owner/un admin, o che il gruppo si sciolga, la
// riga resta con frozenAt valorizzato. Effetti: la sessione resta nel suo elenco
// contrassegnata "archiviata"; vede SOLO i messaggi precedenti a frozenAt; non
// compare tra i partecipanti attivi, cosi' chi resta a scrivere sa chi lo legge.
// Regola: "vedi cio' che hai vissuto, non cio' che e' successo dopo che sei uscito".
// Vedi spec-chat-ai-collaborativa.md sez. 4-bis.
model AiConversationParticipant {
  id              String         @id @default(cuid())
  workspaceId     String
  conversationId  String
  userId          String
  role            String         @default("member") @db.VarChar(16)
  invitedByUserId String?
  frozenAt        DateTime?
  createdAt       DateTime       @default(now())
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation    AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User           @relation("AiConversationParticipantUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedByUser   User?          @relation("AiConversationParticipantInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@unique([conversationId, userId])
  @@index([workspaceId, userId])
  @@index([userId])
}

// Messaggio di una conversazione. authorUserId = autore umano (mostrato in UI);
// null quando il messaggio e' dell'AI (role='assistant'). citationsJson conserva
// gli estratti/fonti citati (RAG) dei messaggi dell'assistente.
model AiConversationMessage {
  id             String         @id @default(cuid())
  workspaceId    String
  conversationId String
  authorUserId   String?
  role           String         @db.VarChar(16)
  content        String         @db.Text
  citationsJson  Json?
  createdAt      DateTime       @default(now())
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         User?          @relation("AiConversationMessageAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  attachments    AiConversationAttachment[]

  @@index([conversationId, createdAt])
  @@index([workspaceId])
}

// Allegato di un messaggio della chat (Fase 3a — allegati documenti + entità CRM).
// Porta contesto SPECIFICO dentro la conversazione, sopra il contesto d'ambito:
//   kind='file'   -> documento caricato (TXT/CSV/MD/DOCX/PDF). Come per le Fonti,
//                    il binario NON viene conservato: si salva solo il testo estratto.
//   kind='entity' -> elemento del CRM (progetto/cliente/fonte/preventivo), di cui si
//                    salva uno SNAPSHOT testuale al momento dell'allegato, così il
//                    contesto resta quello che l'utente vedeva quando ha allegato.
// messageId è null finché l'allegato è una BOZZA (caricato nel composer ma non ancora
// inviato); l'invio del messaggio lo lega e lo rende immutabile. Le bozze appartengono
// a chi le ha caricate (createdByUserId), gli allegati inviati a tutta la conversazione.
model AiConversationAttachment {
  id              String                 @id @default(cuid())
  workspaceId     String
  conversationId  String
  messageId       String?
  createdByUserId String?
  kind            String                 @db.VarChar(16)
  entityType      String?                @db.VarChar(24)
  entityId        String?
  label           String                 @db.VarChar(200)
  mimeType        String?                @db.VarChar(120)
  fileSize        Int?
  content         String                 @db.Text
  contentChars    Int                    @default(0)
  createdAt       DateTime               @default(now())
  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation    AiConversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message         AiConversationMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdByUser   User?                  @relation("AiConversationAttachmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  binary          AiConversationAttachmentBinary?

  @@index([messageId])
  @@index([conversationId, createdByUserId, messageId])
  @@index([workspaceId])
}

// Byte VERI di un allegato file (documento o immagine). Tabella separata dal
// record dell'allegato di proposito: i binari possono essere grandi e non devono
// caricarsi a ogni elenco di allegati — si leggono SOLO quando si scarica il file.
// 1-a-1 con l'allegato (attachmentId e' chiave primaria e chiave esterna); cancellato
// l'allegato, cade anche il binario (cascade). Sostituisce il vecchio "estrai il
// testo e butta il file": ora il testo estratto resta in AiConversationAttachment.content
// (per l'AI e il RAG) e QUI ci sono i byte originali (per riscaricare/anteprima e,
// in futuro con le chiavi, per la "vista" multimodale sulle immagini).
model AiConversationAttachmentBinary {
  attachmentId String                   @id
  data         Bytes
  createdAt    DateTime                 @default(now())
  attachment   AiConversationAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
}

// Budget di spesa AI giornaliero (V4 — cost control). Limite in USD sulla spesa AI
// giornaliera. Una riga per dipendente (override), più una riga "default" del
// workspace identificata da un userId sentinella (vedi AI_BUDGET_DEFAULT_USER nel
// repository) — così l'unicità su (workspaceId, userId) resta pulita senza NULL.
// dailyLimitUsd = 0 significa "nessun limite" (illimitato).
model AiBudget {
  id            String    @id @default(cuid())
  workspaceId   String
  userId        String
  dailyLimitUsd Float     @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
}

