generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum QuoteDiscountType {
  PERCENT
  FIXED
}

enum QuoteEmailLogType {
  send
  resend
}

enum EmailSendStatus {
  success
  fail
}

enum ClientType {
  person
  company
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum WebAssetStatus {
  ACTIVE
  MAINTENANCE
  PAUSED
  ARCHIVED
}

enum WebAssetVersionStatus {
  DRAFT
  STAGED
  LIVE
}

enum WebAssetDeploymentEnvironment {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum WebAssetHealthStatus {
  UP
  DEGRADED
  DOWN
}

enum WebAssetMaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum WebAssetAlertType {
  DOWNTIME
  PERFORMANCE
  ERROR_RATE
  MAINTENANCE
}

enum WebAssetAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum WebAssetAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ChecklistTemplateAppliesTo {
  PROJECT_STAGE
  WEB_ASSET_STATUS
}

enum AgencyProjectStatus {
  DISCOVERY
  PLANNING
  PRODUCTION
  REVIEW
  LIVE
  PAUSED
  ARCHIVED
}

enum AgencyPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectAlertSeverity {
  LOW
  MEDIUM
  HIGH
}

enum ProjectAlertStatus {
  OPEN
  MONITORING
  RESOLVED
  SUGGESTED
}

enum ProjectOpportunityStatus {
  OPEN
  PROPOSED
  WON
  LOST
  SUGGESTED
}

model Workspace {
  id                         String                      @id @default(cuid())
  name                       String
  slug                       String                      @unique
  status                     WorkspaceStatus             @default(ACTIVE)
  suspendedAt                DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  memberships                Membership[]
  teamInvites                TeamInvite[]
  clients                    Client[]
  workspaceModules           WorkspaceModule[]
  roles                      Role[]
  userRoles                  UserRole[]
  departments                Department[]
  departmentMembers          DepartmentMember[]
  branding                   WorkspaceBranding?
  quoteNotificationSettings  QuoteNotificationSettings?
  projects                   Project[]
  projectCategories          ProjectCategory[]
  pipelineStages             PipelineStage[]
  quotes                     Quote[]
  quoteItems                 QuoteItem[]
  quoteTemplates             QuoteTemplate[]
  quoteTemplateItems         QuoteTemplateItem[]
  quoteEmailLogs             QuoteEmailLog[]
  calendarEvents             CalendarEvent[]
  websiteAssets              WebsiteAsset[]
  webAppAssets               WebAppAsset[]
  ecommerceAssets            EcommerceAsset[]
  webAssetVersions           WebAssetVersion[]
  webAssetHealthChecks       WebAssetHealthCheck[]
  webAssetSeoReports         WebAssetSeoReport[]
  webAssetAnalyticsSnapshots WebAssetAnalyticsSnapshot[]
  webAssetAnalyticsEvents    WebAssetAnalyticsEvent[]
  webAssetMaintenanceWindows WebAssetMaintenanceWindow[]
  webAssetAlerts             WebAssetAlert[]
  auditLogs                  AuditLog[]
  workspaceMessages          WorkspaceMessage[]
  vaultItems                 VaultItem[]
  vaultKeys                  WorkspaceVaultKey[]
  vaultPolicy                WorkspaceVaultPolicy?
  checklistTemplates         ChecklistTemplate[]
  checklistTemplateItems     ChecklistTemplateItem[]
  checklistInstances         ChecklistInstance[]
  checklistInstanceItems     ChecklistInstanceItem[]
  stageChecklistRules        StageChecklistRule[]
  projectTypes               ProjectType[]
  projectActiveModules       ProjectActiveModule[]
  projectMemories            ProjectMemory[]
  projectAlerts              ProjectAlert[]
  projectOpportunities       ProjectOpportunity[]
  projectTasks               ProjectTask[]
  agencyRuntimeSettings      AgencyRuntimeSetting[]
}

model User {
  id                                    String                      @id @default(cuid())
  email                                 String                      @unique
  googleSub                             String?                     @unique
  name                                  String?
  passwordHash                          String?
  vaultPasswordHash                     String?
  role                                  String                      @default("member")
  isPlatformAdmin                       Boolean                     @default(false)
  themePreference                       String?                     @db.VarChar(10)
  avatarUrl                             String?                     @db.Text
  createdAt                             DateTime                    @default(now())
  updatedAt                             DateTime                    @updatedAt
  memberships                           Membership[]
  teamInvitesSent                       TeamInvite[]                @relation("TeamInviteInvitedByUser")
  teamInvitesAccepted                   TeamInvite[]                @relation("TeamInviteAcceptedByUser")
  userRoles                             UserRole[]
  departmentMembers                     DepartmentMember[]
  ownedProjects                         Project[]                   @relation("ProjectOwner")
  projectAccess                         ProjectAccess[]
  createdQuotes                         Quote[]                     @relation("QuoteCreatedByUser")
  createdCalendarEvents                 CalendarEvent[]             @relation("CalendarEventCreatedByUser")
  updatedCalendarEvents                 CalendarEvent[]             @relation("CalendarEventUpdatedByUser")
  ownedWebsiteAssets                    WebsiteAsset[]              @relation("WebsiteAssetOwner")
  ownedWebAppAssets                     WebAppAsset[]               @relation("WebAppAssetOwner")
  ownedEcommerceAssets                  EcommerceAsset[]            @relation("EcommerceAssetOwner")
  createdWebAssetVersions               WebAssetVersion[]           @relation("WebAssetVersionCreatedByUser")
  createdWebAssetHealthChecks           WebAssetHealthCheck[]       @relation("WebAssetHealthCheckCreatedByUser")
  createdWebAssetSeoReports             WebAssetSeoReport[]         @relation("WebAssetSeoReportCreatedByUser")
  createdWebAssetAnalyticsSnapshots     WebAssetAnalyticsSnapshot[] @relation("WebAssetAnalyticsSnapshotCreatedByUser")
  createdWebAssetAnalyticsEvents        WebAssetAnalyticsEvent[]    @relation("WebAssetAnalyticsEventCreatedByUser")
  createdWebAssetMaintenanceWindows     WebAssetMaintenanceWindow[] @relation("WebAssetMaintenanceWindowCreatedByUser")
  updatedWebAssetMaintenanceWindows     WebAssetMaintenanceWindow[] @relation("WebAssetMaintenanceWindowUpdatedByUser")
  createdWebAssetAlerts                 WebAssetAlert[]             @relation("WebAssetAlertCreatedByUser")
  sentWorkspaceMessages                 WorkspaceMessage[]          @relation("WorkspaceMessageSender")
  receivedWorkspaceMessages             WorkspaceMessage[]          @relation("WorkspaceMessageRecipient")
  createdVaultItems                     VaultItem[]                 @relation("VaultItemCreatedByUser")
  updatedVaultItems                     VaultItem[]                 @relation("VaultItemUpdatedByUser")
  auditLogs                             AuditLog[]                  @relation("AuditActor")
  completedChecklistItems               ChecklistInstanceItem[]     @relation("ChecklistItemCompletedByUser")
  assignedChecklistItems                ChecklistInstanceItem[]     @relation("ChecklistItemAssignedToUser")
  assignedChecklistItemsBy              ChecklistInstanceItem[]     @relation("ChecklistItemAssignedByUser")
  defaultAssignedChecklistTemplateItems ChecklistTemplateItem[]     @relation("ChecklistTemplateItemDefaultAssignedToUser")
}

model TeamInvite {
  id               String           @id @default(cuid())
  workspaceId      String
  email            String           @db.VarChar(320)
  tokenHash        String           @unique @db.VarChar(128)
  expiresAt        DateTime
  status           TeamInviteStatus @default(PENDING)
  rolePresetName   String?          @db.VarChar(60)
  invitedByUserId  String
  acceptedByUserId String?
  acceptedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedByUser    User             @relation("TeamInviteInvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedByUser   User?            @relation("TeamInviteAcceptedByUser", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt(sort: Desc)])
  @@index([workspaceId, email, status])
  @@index([workspaceId, expiresAt])
}

model Membership {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model Client {
  id              String           @id @default(cuid())
  workspaceId     String
  type            ClientType       @default(person)
  name            String
  email           String?
  phone           String?
  vatNumber       String?
  taxCode         String?
  street          String?
  city            String?
  zip             String?
  province        String?
  country         String?
  notes           String?
  tags            String[]         @default([])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quotes          Quote[]
  projects        Project[]
  projectLinks    ProjectClient[]
  websiteAssets   WebsiteAsset[]   @relation("WebsiteAssetClient")
  webAppAssets    WebAppAsset[]    @relation("WebAppAssetClient")
  ecommerceAssets EcommerceAsset[] @relation("EcommerceAssetClient")
  vaultItems      VaultItem[]

  @@index([workspaceId, name])
  @@index([workspaceId, email])
  @@index([workspaceId, phone])
  @@index([workspaceId, updatedAt])
}

model Project {
  id                   String                @id @default(cuid())
  workspaceId          String
  clientId             String?
  name                 String
  description          String?
  value                Float?
  dueDate              DateTime?
  pipelineStageId      String?
  projectTypeId        String?
  goal                 String?
  scopePurchased       Json?
  statusAgency         AgencyProjectStatus   @default(DISCOVERY)
  priorityAgency       AgencyPriority        @default(MEDIUM)
  ownerUserId          String?
  startDate            DateTime?
  endDate              DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client               Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientLinks          ProjectClient[]
  pipelineStage        PipelineStage?        @relation(fields: [pipelineStageId], references: [id], onDelete: SetNull)
  projectType          ProjectType?          @relation(fields: [projectTypeId], references: [id], onDelete: SetNull)
  quotes               Quote[]
  websiteAssets        WebsiteAsset[]        @relation("WebsiteAssetProject")
  webAppAssets         WebAppAsset[]         @relation("WebAppAssetProject")
  ecommerceAssets      EcommerceAsset[]      @relation("EcommerceAssetProject")
  activeModules        ProjectActiveModule[]
  projectMemory        ProjectMemory?
  projectAlerts        ProjectAlert[]
  projectOpportunities ProjectOpportunity[]
  projectTasks         ProjectTask[]
  ownerUser            User?                 @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  departments          ProjectDepartment[]
  access               ProjectAccess[]

  @@index([workspaceId, name])
  @@index([workspaceId, clientId])
  @@index([workspaceId, pipelineStageId])
  @@index([workspaceId, projectTypeId])
  @@index([workspaceId, updatedAt])
}

model ProjectType {
  id          String    @id @default(cuid())
  workspaceId String
  key         String
  label       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects    Project[]

  @@unique([workspaceId, key])
  @@index([workspaceId, label])
}

model ProjectActiveModule {
  id          String    @id @default(cuid())
  workspaceId String
  projectId   String
  moduleKey   String
  moduleLabel String?
  included    Boolean   @default(false)
  suggested   Boolean   @default(false)
  active      Boolean   @default(false)
  source      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, moduleKey])
  @@index([workspaceId, projectId])
}

model ProjectMemory {
  id             String    @id @default(cuid())
  workspaceId    String
  projectId      String    @unique
  briefJson      Json?
  sourcesJson    Json?
  webJson        Json?
  adsJson        Json?
  diagnosisJson  Json?
  reportsJson    Json?
  contextSummary String?
  memorySummary  Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId])
}

model ProjectAlert {
  id          String               @id @default(cuid())
  workspaceId String
  projectId   String
  title       String
  description String?
  reason      String?
  severity    ProjectAlertSeverity @default(MEDIUM)
  priority    AgencyPriority       @default(MEDIUM)
  status      ProjectAlertStatus   @default(OPEN)
  source      String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId, status])
}

model ProjectOpportunity {
  id             String                   @id @default(cuid())
  workspaceId    String
  projectId      String
  title          String
  stage          String?
  estimatedValue Decimal?                 @db.Decimal(12, 2)
  status         ProjectOpportunityStatus @default(OPEN)
  category       String?
  type           String?
  rationale      String?
  priority       AgencyPriority?
  score          Int?
  impactLevel    AgencyPriority?
  sourceModule   String?
  sourceSignalKey String?
  dedupKey       String?
  suggestedService String?
  lastEvaluatedAt DateTime?
  source         String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  workspace      Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project        Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId, status])
}

model ProjectTask {
  id              String         @id @default(cuid())
  workspaceId     String
  projectId       String
  title           String
  description     String?
  teamRole        String
  priority        AgencyPriority @default(MEDIUM)
  status          String         @default("todo")
  sourceType      String         @default("manual")
  dependsOnTaskId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dependsOnTask   ProjectTask?   @relation("ProjectTaskDependency", fields: [dependsOnTaskId], references: [id], onDelete: SetNull)
  blockedByTasks  ProjectTask[]  @relation("ProjectTaskDependency")

  @@index([workspaceId, projectId, status])
  @@index([workspaceId, teamRole, status])
}

model AgencyRuntimeSetting {
  id          String    @id @default(cuid())
  workspaceId String
  key         String    @db.VarChar(120)
  valueJson   Json?
  ciphertext  String?   @db.Text
  iv          String?   @db.VarChar(255)
  authTag     String?   @db.VarChar(255)
  keyVersion  Int?
  isSecret    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model ProjectClient {
  id        String   @id @default(cuid())
  projectId String
  clientId  String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([projectId, clientId])
  @@index([projectId, createdAt])
  @@index([clientId, createdAt])
}

model ProjectCategory {
  id                  String               @id @default(cuid())
  workspaceId         String
  name                String
  sortOrder           Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages              PipelineStage[]
  stageChecklistRules StageChecklistRule[]

  @@unique([workspaceId, name])
  @@index([workspaceId, sortOrder])
}

model PipelineStage {
  id                      String               @id @default(cuid())
  workspaceId             String
  categoryId              String?
  name                    String
  sortOrder               Int                  @default(0)
  isClosed                Boolean              @default(false)
  color                   String?              @db.VarChar(20)
  isGated                 Boolean              @default(false)
  gateChecklistTemplateId String?
  autoCreateInstance      Boolean              @default(true)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  workspace               Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category                ProjectCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  gateChecklistTemplate   ChecklistTemplate?   @relation("PipelineStageGateTemplate", fields: [gateChecklistTemplateId], references: [id], onDelete: Restrict)
  stageChecklistRules     StageChecklistRule[]
  projects                Project[]

  @@index([workspaceId, name])
  @@index([workspaceId, sortOrder])
  @@index([workspaceId, categoryId, sortOrder])
  @@index([workspaceId, isGated])
}

model ChecklistTemplate {
  id                  String                     @id @default(cuid())
  workspaceId         String
  name                String                     @db.VarChar(80)
  appliesTo           ChecklistTemplateAppliesTo @default(PROJECT_STAGE)
  description         String?                    @db.VarChar(500)
  isArchived          Boolean                    @default(false)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  workspace           Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items               ChecklistTemplateItem[]
  instances           ChecklistInstance[]
  gatedPipelineStages PipelineStage[]            @relation("PipelineStageGateTemplate")
  stageChecklistRules StageChecklistRule[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model ChecklistTemplateItem {
  id                       String                  @id @default(cuid())
  workspaceId              String
  templateId               String
  title                    String                  @db.VarChar(120)
  description              String?                 @db.VarChar(500)
  sortOrder                Int                     @default(0)
  isRequired               Boolean                 @default(true)
  requiresEvidenceSnapshot Boolean                 @default(false)
  isCriticalSnapshot       Boolean                 @default(false)
  defaultAssignedToUserId  String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  workspace                Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template                 ChecklistTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  defaultAssignedToUser    User?                   @relation("ChecklistTemplateItemDefaultAssignedToUser", fields: [defaultAssignedToUserId], references: [id], onDelete: SetNull)
  instanceItems            ChecklistInstanceItem[]

  @@unique([workspaceId, templateId, sortOrder])
  @@index([workspaceId, templateId])
  @@index([workspaceId, defaultAssignedToUserId])
}

model ChecklistInstance {
  id                  String                  @id @default(cuid())
  workspaceId         String
  projectId           String?
  pipelineStageId     String?
  webAssetId          String?
  checklistTemplateId String
  status              String                  @default("active") @db.VarChar(20)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  workspace           Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template            ChecklistTemplate       @relation(fields: [checklistTemplateId], references: [id], onDelete: Restrict)
  items               ChecklistInstanceItem[]

  @@unique([workspaceId, projectId, pipelineStageId, checklistTemplateId])
  @@index([workspaceId, projectId])
  @@index([workspaceId, pipelineStageId])
  @@index([workspaceId, webAssetId])
}

model StageChecklistRule {
  id                  String            @id @default(cuid())
  workspaceId         String
  projectCategoryId   String
  pipelineStageId     String
  checklistTemplateId String
  gateEnabled         Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectCategory     ProjectCategory   @relation(fields: [projectCategoryId], references: [id], onDelete: Cascade)
  pipelineStage       PipelineStage     @relation(fields: [pipelineStageId], references: [id], onDelete: Cascade)
  checklistTemplate   ChecklistTemplate @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, projectCategoryId, pipelineStageId, checklistTemplateId])
  @@index([workspaceId, projectCategoryId, pipelineStageId, gateEnabled])
  @@index([workspaceId, pipelineStageId])
}

model ChecklistInstanceItem {
  id                       String                @id @default(cuid())
  workspaceId              String
  instanceId               String
  templateItemId           String
  titleSnapshot            String                @db.VarChar(120)
  isRequiredSnapshot       Boolean
  requiresEvidenceSnapshot Boolean
  isCriticalSnapshot       Boolean
  sortOrderSnapshot        Int                   @default(0)
  state                    String                @default("pending") @db.VarChar(20)
  evidenceNote             String?               @db.VarChar(1000)
  evidenceUrl              String?               @db.VarChar(500)
  notApplicableReason      String?               @db.VarChar(500)
  completedAt              DateTime?
  completedByUserId        String?
  assignedToUserId         String?
  assignedByUserId         String?
  assignedAt               DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  workspace                Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instance                 ChecklistInstance     @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  templateItem             ChecklistTemplateItem @relation(fields: [templateItemId], references: [id], onDelete: Restrict)
  completedByUser          User?                 @relation("ChecklistItemCompletedByUser", fields: [completedByUserId], references: [id], onDelete: SetNull)
  assignedToUser           User?                 @relation("ChecklistItemAssignedToUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  assignedByUser           User?                 @relation("ChecklistItemAssignedByUser", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, instanceId, templateItemId])
  @@index([workspaceId, instanceId])
  @@index([workspaceId, instanceId, sortOrderSnapshot])
  @@index([workspaceId, assignedToUserId])
  @@index([workspaceId, state])
}

model WebsiteAsset {
  id                    String                        @id @default(cuid())
  workspaceId           String
  clientId              String?
  projectId             String?
  ownerUserId           String?
  name                  String
  url                   String                        @db.VarChar(2048)
  status                WebAssetStatus                @default(ACTIVE)
  deploymentEnvironment WebAssetDeploymentEnvironment @default(DEVELOPMENT)
  version               String?                       @db.VarChar(64)
  metadata              Json?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  workspace             Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client                Client?                       @relation("WebsiteAssetClient", fields: [clientId], references: [id], onDelete: SetNull)
  project               Project?                      @relation("WebsiteAssetProject", fields: [projectId], references: [id], onDelete: SetNull)
  ownerUser             User?                         @relation("WebsiteAssetOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, url])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, status])
  @@index([workspaceId, deploymentEnvironment])
  @@index([workspaceId, clientId])
  @@index([workspaceId, projectId])
}

model WebAppAsset {
  id                    String                        @id @default(cuid())
  workspaceId           String
  clientId              String?
  projectId             String?
  ownerUserId           String?
  name                  String
  url                   String                        @db.VarChar(2048)
  status                WebAssetStatus                @default(ACTIVE)
  deploymentEnvironment WebAssetDeploymentEnvironment @default(DEVELOPMENT)
  version               String?                       @db.VarChar(64)
  metadata              Json?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  workspace             Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client                Client?                       @relation("WebAppAssetClient", fields: [clientId], references: [id], onDelete: SetNull)
  project               Project?                      @relation("WebAppAssetProject", fields: [projectId], references: [id], onDelete: SetNull)
  ownerUser             User?                         @relation("WebAppAssetOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, url])
  @@index([workspaceId, updatedAt])
  @@index([workspaceId, status])
  @@index([workspaceId, deploymentEnvironment])
  @@index([workspaceId, clientId])
  @@index([workspaceId, projectId])
}

model EcommerceAsset {
  id                    String                        @id @default(cuid())
  workspaceId           String
  clientId              String?
  projectId             String?
  ownerUserId           String?
  name                  String
  url                   String                        @db.VarChar(2048)
  status                WebAssetStatus                @default(ACTIVE)
  deploymentEnvironment WebAssetDeploymentEnvironment @default(DEVELOPMENT)
  version               String?                       @db.VarChar(64)
  metadata              Json?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  workspace             Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client                Client?                       @relation("EcommerceAssetClient", fields: [clientId], references: [id], onDelete: SetNull)
  project               Project?                      @relation("EcommerceAssetProject", fields: [projectId], references: [id], onDelete: SetNull)
  ownerUser             User?                         @relation("EcommerceAssetOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

